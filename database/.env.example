# Reference template only; tools do NOT automatically load this file.
# Set these as environment variables using your shell or secret manager.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=game
MYSQL_USER=your_migration_account
MYSQL_PASSWORD=replace_locally

# Dedicated disposable MySQL instance for live tests, not the application DB.
# Tests create/drop only their own random chess_schema_test_<hex> databases.
MYSQL_TEST_HOST=127.0.0.1
MYSQL_TEST_PORT=33379
MYSQL_TEST_USER=your_test_account
MYSQL_TEST_PASSWORD=replace_locally
